{
  "id": "fieldops-tools",
  "name": "FieldOps Tools",
  "description": "Tools for the FieldOps inventory and dispatch backend: assets & consumables, loadouts & checkout, orders & transfers, vendors & purchase orders, crew members, scheduling & check-in, alerts, vehicles & location, and documents.",
  "version": "0.1.0",
  "configSchema": {
    "type": "object",
    "properties": {
      "backendUrl": {
        "type": "string",
        "description": "FieldOps backend API base URL, e.g. http://localhost:3000/api/v1"
      }
    }
  },
  "activation": {
    "onStartup": true
  },
  "contracts": {
    "tools": [
      "list_assets",
      "get_asset",
      "register_asset",
      "verify_asset",
      "update_asset_status",
      "list_consumables",
      "adjust_consumable_quantity",
      "list_sites",
      "get_site",
      "register_site",
      "get_site_inventory",
      "list_loadouts",
      "create_loadout",
      "resolve_loadout",
      "checkout_asset",
      "return_checkout",
      "list_overdue_checkouts",
      "create_order",
      "list_orders",
      "update_order_status",
      "compile_purchase_order",
      "request_transfer",
      "update_transfer_status",
      "list_vendors",
      "add_vendor",
      "send_purchase_order",
      "mark_purchase_order_fulfilled",
      "list_crew_members",
      "register_crew_member",
      "assign_shift",
      "assign_shifts_batch",
      "confirm_shift",
      "list_shifts",
      "log_timeclock_event",
      "get_crew_status",
      "list_alerts",
      "resolve_alert",
      "log_vehicle_location",
      "start_trip",
      "end_trip",
      "list_vehicle_trips",
      "log_document",
      "list_documents",
      "list_expiring_documents"
    ]
  }
}
