# Postgres
POSTGRES_PASSWORD=

# Backend
ALERTS_CHECK_INTERVAL_MS=300000

# Model providers (see docs/ARCHITECTURE.md — DeepSeek primary, Claude fallback)
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=

# OpenClaw gateway
OPENCLAW_GATEWAY_TOKEN=

# Cloudflare Tunnel (see docs/DEPLOYMENT.md)
CLOUDFLARE_TUNNEL_TOKEN=

# Dashboard / agent auth (see docs/DEPLOYMENT.md#dashboard-auth-rollout)
# Generate with: openssl rand -hex 32
# Set the SAME value here and via `openclaw config set
# plugins.entries.fieldops-tools.config.serviceToken "<value>"` on the agent
# side, in that order, before deploying this — otherwise the WhatsApp agent
# loses backend access the moment this env var is set.
AGENT_SERVICE_TOKEN=
